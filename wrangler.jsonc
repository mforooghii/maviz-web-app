{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maviz-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "36e7842d-28e0-41cc-b913-f51412713ae1","database_name": "Mavizweb-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4c8e6f5a1b04444db5b298629e62b34f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
